# Gemini API key for AI vision analysis (free tier available)
GEMINI_API_KEY=AIzaSy...

# Kaggle credentials (for downloading test datasets)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional: screenshot save directory (defaults to ~/ai_screenshots)
SCREENSHOT_DIR=~/ai_screenshots

# Optional: default AI model
AI_MODEL=gemini-2.0-flash
